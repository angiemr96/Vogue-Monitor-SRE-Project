{
"uid": "vogue-monitor",
"title": "Vogue Monitoring Dashboard",
"schemaVersion": 38,
"refresh": "30s",
"version": 1,
"editable": true,
"timezone": "browser",
"panels": [
{
"type": "graph",
"title": "Uptime last 24h",
"id": 1,
"targets": [
{
"expr": "avg_over_time(probe_success[24h])",
"format": "time_series",
"legendFormat": "Uptime %"
}
],
"gridPos": { "x": 0, "y": 0, "w": 12, "h": 6 }
},
{
"type": "graph",
"title": "Average latency (ms)",
"id": 2,
"targets": [
{
"expr": "avg_over_time(probe_duration_seconds[5m]) * 1000",
"format": "time_series",
"legendFormat": "Latency (ms)"
}
],
"gridPos": { "x": 0, "y": 6, "w": 12, "h": 6 }
},
{
"type": "graph",
"title": "Response Codes Trend",
"id": 3,
"targets": [
{
"expr": "count_over_time(probe_http_status[1h])",
"format": "time_series",
"legendFormat": "HTTP Status"
}
],
"gridPos": { "x": 0, "y": 12, "w": 12, "h": 6 }
},
{
"type": "stat",
"title": "SSL Certificate Expiry Countdown (Days)",
"id": 4,
"targets": [
{
"expr": "(ssl_cert_expiry - time()) / 86400",
"format": "time_series",
"legendFormat": "Days Left"
}
],
"gridPos": { "x": 0, "y": 18, "w": 12, "h": 6 }
}
]
}